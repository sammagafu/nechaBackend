APP_ENV=development
SERVER_PORT=8080
CORS_ALLOWED_ORIGIN=https://necha.africa

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nechaafrica
DB_SSLMODE=disable

JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=168h

ADMIN_EMAIL=admin@necha.africa
ADMIN_PASSWORD=admin12345

# Email notifications (inquiries, guest requests, orders)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@necha.africa

# SMS notifications (order alerts to admin + hotel). Provider-agnostic HTTP gateway:
# a JSON POST {"from","to","text"} is sent to SMS_API_URL with an optional Bearer key.
# When SMS_ENABLED=false or SMS_API_URL is empty, messages are logged only.
SMS_ENABLED=false
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=NECHA
# Admin phone number that receives order-alert SMS (E.164, e.g. +2557xxxxxxxx)
ADMIN_PHONE=

# In production set SEED_DEMO_DATA=true to create demo customer accounts on boot
SEED_DEMO_DATA=false
DEMO_GUEST_EMAIL=guest@necha.africa
DEMO_GUEST_PASSWORD=guest12345
DEMO_SHOPPER_EMAIL=shopper@necha.africa
DEMO_SHOPPER_PASSWORD=shop12345

KKOOAPP_BASE_URL=https://api.kkooapp.com/v1
KKOOAPP_API_KEY=
KKOOAPP_TIMEOUT_SECONDS=30
KKOOAPP_ENDPOINT_HOTEL_RESERVATION=/reservations/hotel
KKOOAPP_ENDPOINT_TABLE_RESERVATION=/reservations/table
KKOOAPP_ENDPOINT_FOOD_ORDER=/orders/food
KKOOAPP_ENDPOINT_ORDER_STATUS=/orders/{id}/status

WEBHOOK_INBOUND_SECRET=

# Selcom payment gateway (https://developers.selcommobile.com/)
SELCOM_BASE_URL=https://apigw.selcommobile.com
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR=
SELCOM_TIMEOUT_SECONDS=30
SELCOM_MOCK=false
SELCOM_WEBHOOK_SECRET=
PUBLIC_API_URL=http://localhost:8080
PUBLIC_APP_URL=http://localhost:3000

# Distance-based delivery pricing (haversine from hotel lat/lng; falls back to zone fee when coords missing)
DELIVERY_BASE_FEE_TZS=3000
DELIVERY_PER_KM_TZS=1000
# Founding partner commission tier duration in months (auto-revert to standard, brief §4.2)
FOUNDING_TIER_MONTHS=13

GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
